{
  "name": "glod",
  "version": "1.0.0",
  "description": "Glod — production-ready modular Discord bot (Discord.js v14, TypeScript, SQLite)",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "deploy": "npm run build && node dist/scripts/deploy-commands.js",
    "clean:global": "npm run build && node dist/scripts/clear-global-commands.js",
    "clean:guild": "npm run build && node dist/scripts/clear-guild-commands.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "winston": "^3.17.0",
    "chalk": "^4.1.2",
    "dayjs": "^1.11.13",
    "ms": "^2.1.3",
    "canvas": "^3.1.0",
    "lavalink-client": "^2.6.5",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/express": "^4.17.21",
    "@types/ms": "^0.7.34",
    "typescript": "^5.7.2",
    "ts-node": "^10.9.2",
    "@types/ws": "^8.5.13"
  },
  "license": "MIT"
}
