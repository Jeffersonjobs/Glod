# ── Glod · Environment ──
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
# Local SQLite (sin servicios externos)
SQLITE_PATH=./data/glod.db
DEFAULT_LOCALE=es
NODE_ENV=production

# Dashboard API
API_ENABLED=true
API_PORT=3001
API_TOKEN=change-me-strong-token
DASHBOARD_URL=http://localhost:3000

# Lavalink (music). Leave empty to run without music.
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_NAME=glod-main

# Optional Redis for cooldown persistence (falls back to memory)
REDIS_URL=

# Owner IDs (comma separated) for dev commands
OWNER_IDS=
